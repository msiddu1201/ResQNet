# ResQNet Frontend Environment Configuration

# Backend API Base URL (Omit in local dev to use Vite proxy, or set to your Render URL in production)
# Example: https://resqnet-server.onrender.com
VITE_API_URL=

# Backend WebSocket URL (Omit in local dev, or set to your Render URL in production)
# Example: https://resqnet-server.onrender.com
VITE_SOCKET_URL=
